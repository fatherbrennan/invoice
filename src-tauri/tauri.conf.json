{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Invoice",
  "version": "0.1.0",
  "identifier": "au.local.invoice",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Invoice",
        "width": 1280,
        "height": 850,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' blob:; worker-src 'self' blob:; img-src 'self' asset: http://asset.localhost data:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "fonts/IBMPlexSans-OFL.txt": "licenses/IBMPlexSans-OFL.txt",
      "../static/licenses/Subsetter-notices.txt": "licenses/Subsetter-notices.txt"
    },
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
